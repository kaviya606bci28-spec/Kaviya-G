#include <stdio.h>

int main()
{
    int a, b;
    float c, d;

    // Read input
    scanf("%d %d", &a, &b);
    scanf("%f %f", &c, &d);

    // Print sum and difference of integers
    printf("%d %d\n", a + b, a - b);

    // Print sum and difference of floats
    printf("%.1f %.1f\n", c + d, c - d);

    return 0;
}
