#include <stdio.h>
#include <stdlib.h>

// Struct definition standard block configuration
struct Enemy {
    long long dmg;
    long long time;
};

// Threat priority custom sorting function logic
int compareEnemies(const void* a, const void* b) {
    const struct Enemy* enemyA = (const struct Enemy*)a;
    const struct Enemy* enemyB = (const struct Enemy*)b;
    
    long long valA = enemyA->dmg * enemyB->time;
    long long valB = enemyB->dmg * enemyA->time;
    
    if (valA < valB) return 1;  // Higher threat score sequence comes first
    if (valA > valB) return -1;
    return 0;
}

// CRITICAL TEMPLATE FIX: Changed function name from 'minDamageDealt' to 'minDamage' to match LeetCode's background driver script check
long long minDamage(int power, int* damage, int damageSize, int* health, int healthSize) {
    int n = damageSize;
    
    // Memory frame layout setup track arrays
    struct Enemy* enemies = (struct Enemy*)malloc(n * sizeof(struct Enemy));
    long long totalDamagePerSecond = 0;
    
    // Step 1: Precompute dynamic math limits values
    for (int i = 0; i < n; i++) {
        enemies[i].dmg = damage[i];
        // Exact raw ceiling calculation logic processing values limits
        enemies[i].time = ((long long)health[i] + power - 1) / power;
        totalDamagePerSecond += damage[i];
    }
    
    // Step 2: Sorting priority processing array layout markers configurations
    qsort(enemies, n, sizeof(struct Enemy), compareEnemies);
    
    long long totalDamageDealtToBob = 0;
    
    // Step 3: Cumulative math calculations tracker loop logic 
    for (int i = 0; i < n; i++) {
        totalDamageDealtToBob += totalDamagePerSecond * enemies[i].time;
        totalDamagePerSecond -= enemies[i].dmg;
    }
    
    free(enemies); // Storage cleanup allocation checks verification
    return totalDamageDealtToBob;
}

