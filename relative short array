#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int* relativeSortArray(int* arr1, int arr1Size, int* arr2, int arr2Size, int* returnSize) {
    // Exact size allocation for the result array
    int* result = (int*)malloc(arr1Size * sizeof(int));
    *returnSize = arr1Size;
    
    // Create a frequency lookup map array since max value constraint is 1000
    int freq[1001] = {0};
    for (int i = 0; i < arr1Size; i++) {
        freq[arr1[i]]++;
    }
    
    int idx = 0;
    
    // Step 1: Place elements of arr1 following the relative ordering sequence of arr2
    for (int i = 0; i < arr2Size; i++) {
        int element = arr2[i];
        while (freq[element] > 0) {
            result[idx++] = element;
            freq[element]--;
        }
    }
    
    // Step 2: Append leftover elements (not present in arr2) automatically in ascending order
    for (int num = 0; num <= 1000; num++) {
        while (freq[num] > 0) {
            result[idx++] = num;
            freq[num]--;
        }
    }
    
    return result;
}
