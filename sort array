#include <stdio.h>
#include <stdlib.h>

// Elements-ah swap panra precise helper function
void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// FIXED: Iterative Heapify to prevent Stack Overflow and ensure O(1) auxiliary space
void heapify(int* nums, int size, int idx) {
    while (1) {
        int largest = idx;
        int left = 2 * idx + 1;
        int right = 2 * idx + 2;

        if (left < size && nums[left] > nums[largest]) {
            largest = left;
        }

        if (right < size && nums[right] > nums[largest]) {
            largest = right;
        }

        // If largest is still root, heap property is satisfied
        if (largest == idx) {
            break;
        }

        swap(&nums[idx], &nums[largest]);
        idx = largest; // Move down the tree iteratively
    }
}

int* sortArray(int* nums, int numsSize, int* returnSize) {
    *returnSize = numsSize;
    
    if (numsSize <= 1) return nums;

    // Step 1: Max Heap build panrom bottom-up approach-la
    for (int i = numsSize / 2 - 1; i >= 0; i--) {
        heapify(nums, numsSize, i);
    }

    // Step 2: Extract elements one by one from heap tail end positions
    for (int i = numsSize - 1; i > 0; i--) {
        // FIXED: Correct pointer syntax to swap root element with current last element
        swap(&nums[0], &nums[i]);

        // Reduce heap size and rebuild max heap property from root
        heapify(nums, i, 0);
    }

    return nums;
}
